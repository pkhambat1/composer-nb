{
  "name": "composer-nb",
  "version": "0.6.0",
  "private": true,
  "description": "The composer-nb language and engine, used by the web app and the MCP server. Not published.",
  "author": "Pezanne Khambatta",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./engine": {
      "composer-nb-source": "./js/music-engine.ts",
      "types": "./lib/music-engine.d.ts",
      "default": "./lib/music-engine.js"
    },
    "./language": {
      "composer-nb-source": "./js/language.ts",
      "types": "./lib/language.d.ts",
      "default": "./lib/language.js"
    },
    "./chord-lookup": {
      "composer-nb-source": "./js/chord-lookup.ts",
      "types": "./lib/chord-lookup.d.ts",
      "default": "./lib/chord-lookup.js"
    },
    "./editing": {
      "composer-nb-source": "./js/editing.ts",
      "types": "./lib/editing.d.ts",
      "default": "./lib/editing.js"
    },
    "./grid": {
      "composer-nb-source": "./js/grid.ts",
      "types": "./lib/grid.d.ts",
      "default": "./lib/grid.js"
    },
    "./sheet": {
      "composer-nb-source": "./js/sheet.ts",
      "types": "./lib/sheet.d.ts",
      "default": "./lib/sheet.js"
    },
    "./midi": {
      "composer-nb-source": "./js/midi.ts",
      "types": "./lib/midi.d.ts",
      "default": "./lib/midi.js"
    },
    "./highlight": {
      "composer-nb-source": "./js/highlight.ts",
      "types": "./lib/highlight.d.ts",
      "default": "./lib/highlight.js"
    },
    "./chords": {
      "composer-nb-source": "./js/chords.ts",
      "types": "./lib/chords.d.ts",
      "default": "./lib/chords.js"
    },
    "./grooves": {
      "composer-nb-source": "./js/grooves.ts",
      "types": "./lib/grooves.d.ts",
      "default": "./lib/grooves.js"
    },
    "./links": {
      "composer-nb-source": "./js/links.ts",
      "types": "./lib/links.d.ts",
      "default": "./lib/links.js"
    }
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "rm -rf lib && tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tombatossals/chords-db": "0.5.1",
    "abcjs": "^6.7.1",
    "tonal": "^6.4.2",
    "tone": "14.8.49"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
