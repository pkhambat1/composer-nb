{
  "name": "composer-nb",
  "version": "0.6.0",
  "description": "A small language for drums, notes and chords, with a player for Observable notebooks and web pages.",
  "keywords": [
    "music",
    "chords",
    "drums",
    "observable",
    "notebook",
    "dsl"
  ],
  "homepage": "https://github.com/pkhambat1/composer-nb",
  "bugs": "https://github.com/pkhambat1/composer-nb/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkhambat1/composer-nb.git",
    "directory": "dsl"
  },
  "author": "Pezanne Khambatta",
  "license": "MIT",
  "type": "module",
  "main": "./dist/composer-nb.js",
  "types": "./lib/music.d.ts",
  "exports": {
    ".": {
      "types": "./lib/music.d.ts",
      "default": "./dist/composer-nb.js"
    },
    "./engine": {
      "types": "./lib/music-engine.d.ts",
      "composer-nb-source": "./js/music-engine.ts",
      "default": "./lib/music-engine.js"
    },
    "./language": {
      "types": "./lib/language.d.ts",
      "composer-nb-source": "./js/language.ts",
      "default": "./lib/language.js"
    },
    "./chord-lookup": {
      "types": "./lib/chord-lookup.d.ts",
      "composer-nb-source": "./js/chord-lookup.ts",
      "default": "./lib/chord-lookup.js"
    },
    "./editing": {
      "types": "./lib/editing.d.ts",
      "composer-nb-source": "./js/editing.ts",
      "default": "./lib/editing.js"
    },
    "./grid": {
      "types": "./lib/grid.d.ts",
      "composer-nb-source": "./js/grid.ts",
      "default": "./lib/grid.js"
    },
    "./sheet": {
      "types": "./lib/sheet.d.ts",
      "composer-nb-source": "./js/sheet.ts",
      "default": "./lib/sheet.js"
    },
    "./midi": {
      "types": "./lib/midi.d.ts",
      "composer-nb-source": "./js/midi.ts",
      "default": "./lib/midi.js"
    },
    "./highlight": {
      "types": "./lib/highlight.d.ts",
      "composer-nb-source": "./js/highlight.ts",
      "default": "./lib/highlight.js"
    },
    "./chords": {
      "types": "./lib/chords.d.ts",
      "composer-nb-source": "./js/chords.ts",
      "default": "./lib/chords.js"
    },
    "./grooves": {
      "types": "./lib/grooves.d.ts",
      "composer-nb-source": "./js/grooves.ts",
      "default": "./lib/grooves.js"
    },
    "./links": {
      "types": "./lib/links.d.ts",
      "composer-nb-source": "./js/links.ts",
      "default": "./lib/links.js"
    }
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "tsc -p . && vite build && vite build --mode npm",
    "build:lib": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tombatossals/chords-db": "0.5.1",
    "abcjs": "^6.7.1",
    "tonal": "^6.4.2",
    "tone": "14.8.49"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
