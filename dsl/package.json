{
  "name": "composer-nb",
  "version": "0.3.1",
  "description": "A small language for chords and drums, with a player for Observable notebooks and web pages.",
  "keywords": [
    "music",
    "chords",
    "drums",
    "observable",
    "notebook",
    "dsl"
  ],
  "homepage": "https://github.com/pkhambat1/composer-nb",
  "bugs": "https://github.com/pkhambat1/composer-nb/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkhambat1/composer-nb.git",
    "directory": "dsl"
  },
  "author": "Pezanne Khambatta",
  "type": "module",
  "main": "./dist/composer-nb.js",
  "exports": {
    ".": "./dist/composer-nb.js",
    "./engine": "./js/music-engine.js",
    "./language": "./js/language.js",
    "./chord-lookup": "./js/chord-lookup.js",
    "./editing": "./js/editing.js",
    "./highlight": "./js/highlight.js"
  },
  "files": [
    "dist",
    "js"
  ],
  "scripts": {
    "build": "vite build && vite build --mode npm",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tombatossals/chords-db": "0.5.1",
    "tonal": "^6.4.2",
    "tone": "14.8.49"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
