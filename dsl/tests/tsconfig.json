{
  // The library's tests, checked as the library is, except that a callback's parameter needs no
  // type of its own: a test says what it calls, and tsc checks that call.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["js", "../js"]
}
