{
  // Tests use the same strict types as the library.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["js", "../js"]
}
