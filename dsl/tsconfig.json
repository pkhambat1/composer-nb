{
  // The library is TypeScript. tsc checks it and compiles it into lib/, the JavaScript the npm
  // package's subpaths point at, with a .d.ts for each module. Vite bundles the player and the
  // Jupyter widget from the same source.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    // Only types on top of JavaScript: no enum or namespace, so Node can run the source as is
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "skipLibCheck": true,
    "rootDir": "js",
    "outDir": "lib"
  },
  "include": ["js"]
}
