{
  "name": "@composer-nb/playground",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --conditions=composer-nb-source scripts/grooves.ts && npm run docs-cell",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p tests && npm run docs-cell -- --check",
    "docs-cell": "node scripts/docs-cell.ts"
  },
  "dependencies": {
    "abcjs": "^6.7.1",
    "composer-nb": "*",
    "marked": "^15.0.7",
    "monaco-editor": "0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tonal": "^6.4.2",
    "tone": "14.8.49",
    "wavesurfer.js": "^7.8.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
