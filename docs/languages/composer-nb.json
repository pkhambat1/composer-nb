{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "composer-nb",
  "scopeName": "source.composer-nb",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#instrument"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#typedBraces"
    },
    {
      "include": "#setting"
    },
    {
      "include": "#invalidSeparator"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#value"
    },
    {
      "include": "#notes"
    },
    {
      "include": "#repeatCount"
    },
    {
      "include": "#numeral"
    },
    {
      "include": "#number"
    },
    {
      "include": "#chord"
    },
    {
      "include": "#steps"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.composer-nb",
      "match": "//.*$"
    },
    "instrument": {
      "name": "entity.name.function.composer-nb",
      "match": "\\b(guitar(\\.electric)?|piano(\\.electric)?|organ|bass|kick|snare(\\.(ghost|rim|cross))?|hat(\\.(open|pedal))?|ride(\\.bell)?|crash|tom\\.(high|low|floor))(?=\\s*:)"
    },
    "declaration": {
      "match": "\\b(steps|sticking|notes|chords|pattern|block)\\s+([A-Za-z][A-Za-z0-9]*)(?=\\s*=)",
      "captures": {
        "1": {
          "name": "storage.type.composer-nb"
        },
        "2": {
          "name": "variable.other.composer-nb"
        }
      }
    },
    "typedBraces": {
      "name": "storage.type.composer-nb",
      "match": "\\b(pattern|block)(?=\\s*\\{)"
    },
    "setting": {
      "match": "^\\s*(set)\\s+(time|tempo|swing|key|mode|transpose|octave|kit|guitar\\.electric)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.composer-nb"
        },
        "2": {
          "name": "keyword.other.setting.composer-nb"
        }
      }
    },
    "keyword": {
      "name": "keyword.control.composer-nb",
      "match": "\\b(play|print|for|on|set|with|bar|bars|beats|steps|chords|to|every|rest|over|in|unison|second|third|fourth|fifth|sixth|seventh|octave|ninth|tenth|eleventh|twelfth|thirteenth|fourteenth|fifteenth)\\b"
    },
    "value": {
      "name": "constant.language.composer-nb",
      "match": "\\b(rock|synth|on|off)\\b"
    },
    "notes": {
      "name": "constant.character.step.composer-nb",
      "match": "(?<![A-Za-z0-9#^~_-])(?=[-_^~A-G#b0-8]*[A-G])(?=[-_^~A-G#b0-8]*[-_])[-_^~A-G#b0-8]+(?![A-Za-z0-9#])"
    },
    "number": {
      "name": "constant.numeric.composer-nb",
      "match": "(?<![A-Za-z])\\d+(\\.\\d+)?(?![A-Za-z])"
    },
    "numeral": {
      "name": "string.unquoted.chord.composer-nb",
      "match": "(?<![A-Za-z0-9#])(?:(?:(?<!\\S)|(?<=[(,|^~*]))-[#b]?[1-9]\\d*|[#b]?(?:VII|VI|IV|V|III|II|I|vii|vi|iv|v|iii|ii|i|[1-9]\\d*))(?:6/9|maj|min|sus|add|dim|dom|aug|alt|M|m|b|#|\\+|\\d)*(?:/(?:[A-G][#b]?|-?[#b]?[1-9]\\d*))?(?![A-Za-z0-9])"
    },
    "chord": {
      "name": "string.unquoted.chord.composer-nb",
      "match": "(?<![A-Za-z0-9-])[A-G][#b]?(m?6/9|[A-Za-z0-9#+]*)(/[A-G][#b]?)?(?![A-Za-z0-9-])"
    },
    "steps": {
      "name": "constant.character.step.composer-nb",
      "match": "(?<![A-Za-z0-9])[x^~d-]+(?![A-Za-z0-9])"
    },
    "punctuation": {
      "name": "punctuation.composer-nb",
      "match": "[{}()|,:=*%_]"
    },
    "invalidSeparator": {
      "name": "invalid.illegal.composer-nb",
      "match": "[;']|\\brest\\b"
    },
    "repeatCount": {
      "name": "constant.numeric.repeat.composer-nb",
      "match": "(?<![A-Za-z0-9.])\\d+(?=\\s*\\*)"
    }
  }
}
