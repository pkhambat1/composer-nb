{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "composer-nb",
  "scopeName": "source.composer-nb",
  "patterns": [
    { "include": "#comment" },
    { "include": "#magic" },
    { "include": "#instrument" },
    { "include": "#declaration" },
    { "include": "#setting" },
    { "include": "#keyword" },
    { "include": "#value" },
    { "include": "#notes" },
    { "include": "#beat" },
    { "include": "#number" },
    { "include": "#numeral" },
    { "include": "#chord" },
    { "include": "#steps" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.composer-nb",
      "match": "//.*$"
    },
    "magic": {
      "name": "meta.preprocessor.composer-nb",
      "match": "^%%music\\b.*$"
    },
    "instrument": {
      "name": "entity.name.function.composer-nb",
      "match": "\\b(guitar(\\.electric)?|piano(\\.electric)?|organ|pad|bass|kick|snare(\\.(ghost|rim))?|hat(\\.(open|pedal))?|ride(\\.bell)?|crash|tom\\.(high|low|floor))(?=\\s*:)"
    },
    "declaration": {
      "match": "\\b(steps|notes|chords|pattern)\\s+([A-Za-z][A-Za-z0-9]*)(?=\\s*=)",
      "captures": {
        "1": { "name": "storage.type.composer-nb" },
        "2": { "name": "variable.other.composer-nb" }
      }
    },
    "setting": {
      "match": "^\\s*(set)\\s+(time|tempo|swing|key|transpose|octave|kit|guitar\\.electric)\\b",
      "captures": {
        "1": { "name": "keyword.control.composer-nb" },
        "2": { "name": "keyword.other.setting.composer-nb" }
      }
    },
    "keyword": {
      "name": "keyword.control.composer-nb",
      "match": "\\b(play|set|of|bar|bars|beats|steps|chords|to|every|rest|over)\\b"
    },
    "value": {
      "name": "constant.language.composer-nb",
      "match": "\\b(rock|synth)\\b"
    },
    "notes": {
      "name": "constant.character.step.composer-nb",
      "match": "(?<![A-Za-z0-9#^~_-])(?=[-_^~A-G#b0-8]*[A-G])(?=[-_^~A-G#b0-8]*[-_])[-_^~A-G#b0-8]+(?![A-Za-z0-9#])"
    },
    "beat": {
      "name": "constant.numeric.beat.composer-nb",
      "match": "(?<![A-Za-z0-9.])\\d+[e&a](?![A-Za-z0-9])"
    },
    "number": {
      "name": "constant.numeric.composer-nb",
      "match": "(?<![A-Za-z])\\d+(\\.\\d+)?(?![A-Za-z])"
    },
    "numeral": {
      "name": "string.unquoted.chord.composer-nb",
      "match": "(?<![A-Za-z0-9#])[#b]?(VII|VI|IV|V|III|II|I|vii|vi|iv|v|iii|ii|i)(6/9|maj|min|sus|add|dim|aug|M|m|b|#|\\+|\\d)*(/[A-G][#b]?)?(?![A-Za-z0-9])"
    },
    "chord": {
      "name": "string.unquoted.chord.composer-nb",
      "match": "(?<![A-Za-z0-9-])[A-G][#b]?(m?6/9|[A-Za-z0-9#+]*)(/[A-G][#b]?)?(?![A-Za-z0-9-])"
    },
    "steps": {
      "name": "constant.character.step.composer-nb",
      "match": "(?<![A-Za-z0-9])[x^~d-]+(?![A-Za-z0-9])"
    },
    "punctuation": {
      "name": "punctuation.composer-nb",
      "match": "[{}()|,:=%_]"
    }
  }
}
