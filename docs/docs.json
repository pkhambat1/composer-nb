{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "composer-nb",
  "description": "Complete composer-nb language and API reference: syntax, global settings, value types, composition, functions and instruments.",
  "colors": {
    "primary": "#1a73e8",
    "light": "#8ab4f8",
    "dark": "#1a73e8"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      },
      "languages": {
        "custom": [
          "/languages/composer-nb.json"
        ]
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Reference",
        "pages": [
          "index",
          "reference/symbols",
          "reference/grammar"
        ]
      },
      {
        "group": "Language",
        "pages": [
          "language/overview",
          "language/values",
          "language/scope",
          "language/expressions"
        ]
      },
      {
        "group": "Global settings",
        "pages": [
          "language/settings",
          "pitched/key"
        ]
      },
      {
        "group": "Value types",
        "pages": [
          "drums/steps",
          "pitched/notes",
          "pitched/chords",
          "pitched/chord-symbols"
        ]
      },
      {
        "group": "Composition",
        "pages": [
          "language/patterns",
          "language/play"
        ]
      },
      {
        "group": "Functions",
        "pages": [
          "functions/intervals",
          "functions/voice",
          "functions/print"
        ]
      },
      {
        "group": "Instruments",
        "pages": [
          "drums/kit",
          "pitched/instruments"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "for-musicians",
          "assistants"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Playground",
        "href": "https://composer-nb.vercel.app"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/"
    },
    {
      "source": "/drums/notation",
      "destination": "/drums/steps"
    },
    {
      "source": "/drums/lines",
      "destination": "/drums/steps"
    },
    {
      "source": "/drums/note-values",
      "destination": "/language/patterns#every"
    },
    {
