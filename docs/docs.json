{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "composer-nb",
  "description": "Reference for the composer-nb language for drums, notes and chords, its Python package and the playground.",
  "colors": {
    "primary": "#1a73e8",
    "light": "#8ab4f8",
    "dark": "#1a73e8"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      },
      "languages": {
        "custom": ["/languages/composer-nb.json"]
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Drums",
        "pages": [
          "drums/notation",
          "drums/lines",
          "drums/note-values"
        ]
      },
      {
        "group": "Notes and chords",
        "pages": [
          "pitched/notes",
          "pitched/chords",
          "pitched/instruments"
        ]
      },
      {
        "group": "Song structure",
        "pages": [
          "song/time-and-tempo",
          "song/patterns",
          "song/play"
        ]
      },
      {
        "group": "Language reference",
        "pages": [
          "reference/program-structure",
          "reference/settings",
          "reference/names",
          "reference/numbers-and-lengths",
          "reference/errors"
        ]
      },
      {
        "group": "Python",
        "pages": [
          "python/installation",
          "python/music-magic",
          "python/song",
          "python/music-widget"
        ]
      },
      {
        "group": "Playground",
        "pages": [
          "playground/notebook",
          "playground/keyboard-shortcuts"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Playground",
        "href": "https://composer-nb.vercel.app"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/composer-nb/"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "redirects": [
    {
      "source": "/language/drums",
      "destination": "/drums/lines"
    },
    {
      "source": "/language/every",
      "destination": "/drums/note-values"
    },
    {
      "source": "/language/chords",
      "destination": "/pitched/chords"
    },
    {
      "source": "/chords/lines",
      "destination": "/pitched/chords"
    },
    {
      "source": "/chords/sound",
      "destination": "/pitched/instruments"
    },
    {
      "source": "/language/patterns",
      "destination": "/song/patterns"
    },
    {
      "source": "/language/play",
      "destination": "/song/play"
    },
    {
      "source": "/language/bar",
      "destination": "/song/patterns#bar"
    },
    {
      "source": "/language/program-structure",
      "destination": "/reference/program-structure"
    },
    {
      "source": "/language/settings",
      "destination": "/reference/settings"
    },
    {
      "source": "/language/declarations",
      "destination": "/reference/names"
    },
    {
      "source": "/language/numbers-and-lengths",
      "destination": "/reference/numbers-and-lengths"
    },
    {
      "source": "/language/errors",
      "destination": "/reference/errors"
    }
  ]
}
