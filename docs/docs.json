{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "composer-nb",
  "description": "Reference for composer-nb, a typed, declarative language for composing music.",
  "colors": {
    "primary": "#1a73e8",
    "light": "#8ab4f8",
    "dark": "#1a73e8"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      },
      "languages": {
        "custom": [
          "/languages/composer-nb.json"
        ]
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "jupyter"
        ]
      },
      {
        "group": "Language",
        "pages": [
          "language/overview",
          "language/settings",
          "language/steps",
          "language/notes",
          "language/chords",
          "language/patterns",
          "language/play"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Playground",
        "href": "https://composer-nb.vercel.app"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/composer-nb/"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/"
    },
    {
      "source": "/drums/notation",
      "destination": "/language/steps"
    },
    {
      "source": "/drums/lines",
      "destination": "/language/steps"
    },
    {
      "source": "/drums/note-values",
      "destination": "/language/steps#step-length"
    },
    {
      "source": "/pitched/notes",
      "destination": "/language/notes"
    },
    {
      "source": "/pitched/chords",
      "destination": "/language/chords"
    },
    {
      "source": "/pitched/instruments",
      "destination": "/language/notes#instruments"
    },
    {
      "source": "/song/time-and-tempo",
      "destination": "/language/settings"
    },
    {
      "source": "/song/patterns",
      "destination": "/language/patterns"
    },
    {
      "source": "/song/play",
      "destination": "/language/play"
    },
    {
      "source": "/reference/program-structure",
      "destination": "/language/overview"
    },
    {
      "source": "/reference/settings",
      "destination": "/language/settings"
    },
    {
      "source": "/reference/names",
      "destination": "/language/overview#types"
    },
    {
      "source": "/reference/numbers-and-lengths",
      "destination": "/language/overview#lengths"
    },
    {
      "source": "/reference/errors",
      "destination": "/language/overview"
    },
    {
      "source": "/python/installation",
      "destination": "/jupyter"
    },
    {
      "source": "/python/music-magic",
      "destination": "/jupyter"
    },
    {
      "source": "/python/song",
      "destination": "/jupyter#song"
    },
    {
      "source": "/python/music-widget",
      "destination": "/jupyter#song"
    },
    {
      "source": "/playground/notebook",
      "destination": "/#run-it"
    },
    {
      "source": "/playground/keyboard-shortcuts",
      "destination": "/#run-it"
    },
    {
      "source": "/language/drums",
      "destination": "/language/steps"
    },
    {
      "source": "/language/every",
      "destination": "/language/steps#step-length"
