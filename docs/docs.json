{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "composer-nb",
  "description": "Reference for composer-nb, a typed, declarative language for composing music.",
  "colors": {
    "primary": "#1a73e8",
    "light": "#8ab4f8",
    "dark": "#1a73e8"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      },
      "languages": {
        "custom": [
          "/languages/composer-nb.json"
        ]
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "for-musicians",
          "jupyter",
          "assistants"
        ]
      },
      {
        "group": "Language",
        "pages": [
          "language/overview",
          "language/settings",
          "language/patterns",
          "language/play"
        ]
      },
      {
        "group": "Drums",
        "pages": [
          "drums/kit",
          "drums/steps"
        ]
      },
      {
        "group": "Pitched instruments",
        "pages": [
          "pitched/instruments",
          "pitched/key",
          "pitched/notes",
          "pitched/chords"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Playground",
        "href": "https://composer-nb.vercel.app"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/composer-nb/"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/pkhambat1/composer-nb"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pkhambat1/composer-nb"
    }
  },
