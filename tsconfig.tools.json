{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "eslint.config.ts",
    "*/vite.config.ts",
    "*/vitest.config.ts",
    "mcp/app/vite.config.ts"
  ]
}
