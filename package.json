{
  "name": "composer-nb-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "dsl",
    "mcp",
    "playground"
  ],
  "scripts": {
    "dev": "npm run dev -w playground",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p api && tsc -p tsconfig.tools.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "cd docs && npx mint dev",
    "mcp": "node --conditions=composer-nb-source mcp/src/bin.ts",
    "seed:local": "node --conditions=composer-nb-source scripts/seed-local-data.mjs",
    "seed:local:check": "node --conditions=composer-nb-source scripts/seed-local-data.mjs --check",
    "verify:local-auth": "node --conditions=composer-nb-source scripts/verify-local-auth.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1"
  }
}
