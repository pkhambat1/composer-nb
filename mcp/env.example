# Server-only deployment variables. Use the same Supabase project as the website.
COMPOSER_NB_ORIGIN=https://composer-nb.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-your-deployment-secret-store

# The website continues using its existing public configuration:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
