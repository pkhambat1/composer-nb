{
  "name": "composer-nb-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server for composer-nb: an assistant writes music as text, checks it, hears it, draws the sheet and sends a link.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "music",
    "drums",
    "notation",
    "composer-nb"
  ],
  "homepage": "https://github.com/pkhambat1/composer-nb",
  "bugs": "https://github.com/pkhambat1/composer-nb/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkhambat1/composer-nb.git",
    "directory": "mcp"
  },
  "author": "Pezanne Khambatta",
  "license": "MIT",
  "type": "module",
  "bin": {
    "composer-nb-mcp": "./lib/bin.js"
  },
  "main": "./lib/server.js",
  "types": "./lib/server.d.ts",
  "exports": {
    ".": {
      "composer-nb-source": "./src/server.ts",
      "types": "./lib/server.d.ts",
      "default": "./lib/server.js"
    },
    "./http": {
      "composer-nb-source": "./src/http.ts",
      "types": "./lib/http.d.ts",
      "default": "./lib/http.js"
    },
    "./cell": {
      "composer-nb-source": "./src/cell.ts",
      "types": "./lib/cell.d.ts",
      "default": "./lib/cell.js"
    },
    "./render": {
      "composer-nb-source": "./src/render.ts",
      "types": "./lib/render.d.ts",
      "default": "./lib/render.js"
    }
  },
  "files": [
    "lib",
    "fonts"
  ],
  "scripts": {
    "reference": "node scripts/reference.ts",
    "build": "npm run reference && npm run build:lib",
    "build:lib": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "build:app": "vite build --config app/vite.config.js",
    "dev:app": "vite --config app/vite.config.js --port 5184",
    "prepack": "npm run build",
    "pretest": "npm run build:app",
    "test": "vitest run",
    "start": "node lib/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "abcjs": "^6.7.1",
    "composer-nb": "^0.6.0",
    "linkedom": "^0.18.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.18"
  }
}
